# --- Branding (single place to change product name) ---
NEXT_PUBLIC_BRAND_NAME=SpiralFolio
NEXT_PUBLIC_BRAND_TAGLINE=Client Intelligence Platform

# --- Database ---
# SQLite file path (relative to spiralfolio/). Default: spiralfolio.db
DATABASE_URL=./spiralfolio.db

# --- AI ---
ANTHROPIC_API_KEY=

# --- Auth (NextAuth — wired in Phase 3) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Integrations ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
ASANA_ACCESS_TOKEN=
# Stringified JSON of a Google service-account credential blob
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Zoom / Apps Script integration ---
# A random secret shared between SpiralFolio and the Apps Script.
# Set the same value as SPIRALFOLIO_API_KEY in Apps Script Properties.
# Leave blank in local dev (auth check is skipped when unset).
SPIRALFOLIO_API_KEY=
