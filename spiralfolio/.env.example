NEXT_PUBLIC_BRAND_NAME="SpiralFolio"
NEXT_PUBLIC_BRAND_TAGLINE="Client Intelligence Platform"

TURSO_AUTH_TOKEN="your-turso-auth-token"

ANTHROPIC_API_KEY="your-anthropic-api-key"

# --- Auth (NextAuth — wired in Phase 3) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Integrations ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
ASANA_ACCESS_TOKEN=
# Stringified JSON of a Google service-account credential blob
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Zoom / Apps Script integration ---
# A random secret shared between SpiralFolio and the Apps Script.
# Set the same value as SPIRALFOLIO_API_KEY in Apps Script Properties.
# Leave blank in local dev (auth check is skipped when unset).
SPIRALFOLIO_API_KEY=

# --- Admin operations console (`/admin`) ---
# Username + password for the admin event log dashboard. Leave any of these
# unset to hard-disable the admin login (the page will refuse all attempts).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 32+ random bytes used to sign session cookies. Generate with e.g.
# `openssl rand -hex 32` and never check the value into source control.
ADMIN_SESSION_SECRET=
